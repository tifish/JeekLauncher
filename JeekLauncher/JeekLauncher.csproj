<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Dev builds stay at 0.0.0.0 (major 0 = dev build); CI overrides with /p:Version=<commit count>. -->
    <Version>0.0.0.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/jeek.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutDir>..\bin\Runtime\</OutDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CETCompat>false</CETCompat>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(OutDir)</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JeekTools.NET\JeekTools.csproj" />
  </ItemGroup>

  <!--
    Keep the app root clean (only JeekLauncher.exe alongside Runtime\, Data\, Scripts\, etc.):
    all managed and native assemblies are built/published into Runtime\, and a standard .NET
    AppHost is created in the parent directory pointing to Runtime/JeekLauncher.dll.
  -->
  <Target Name="CreateNestedAppHostAfterBuild"
          AfterTargets="Build"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_NestedRuntimeDir>$([System.IO.Path]::TrimEndingDirectorySeparator($([System.IO.Path]::GetFullPath('$(TargetDir)'))))</_NestedRuntimeDir>
      <_NestedAppRoot>$([System.IO.Path]::GetDirectoryName('$(_NestedRuntimeDir)'))</_NestedAppRoot>
      <_NestedRuntimeFolderName>$([System.IO.Path]::GetFileName('$(_NestedRuntimeDir)'))</_NestedRuntimeFolderName>
    </PropertyGroup>
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_NestedAppRoot)\$(AssemblyName).exe"
                   DotNetSearchLocations="AppLocal;AppRelative;EnvironmentVariable;Global"
                   AppRelativeDotNet="..\.dotnet"
                   AppBinaryName="$(_NestedRuntimeFolderName)/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                   DisableCetCompat="$(_DisableCetCompat)" />
    <Delete Files="$(_NestedRuntimeDir)\$(AssemblyName).exe"
            Condition="Exists('$(_NestedRuntimeDir)\$(AssemblyName).exe')" />
  </Target>

  <Target Name="CreateNestedAppHostAfterPublish"
          AfterTargets="Publish"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PublishFullDir>$([System.IO.Path]::TrimEndingDirectorySeparator($([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))))</_PublishFullDir>
      <_PublishLeafName>$([System.IO.Path]::GetFileName('$(_PublishFullDir)'))</_PublishLeafName>
      <_PublishRuntimeDir Condition="'$(_PublishLeafName)' == 'Runtime'">$(_PublishFullDir)</_PublishRuntimeDir>
      <_PublishRuntimeDir Condition="'$(_PublishLeafName)' != 'Runtime'">$(_PublishFullDir)\Runtime</_PublishRuntimeDir>
      <_PublishAppRoot Condition="'$(_PublishLeafName)' == 'Runtime'">$([System.IO.Path]::GetDirectoryName('$(_PublishFullDir)'))</_PublishAppRoot>
      <_PublishAppRoot Condition="'$(_PublishLeafName)' != 'Runtime'">$(_PublishFullDir)</_PublishAppRoot>
    </PropertyGroup>
    <ItemGroup Condition="'$(_PublishLeafName)' != 'Runtime'">
      <_LoosePublishedFiles Include="$(_PublishFullDir)\**\*.*"
                            Exclude="$(_PublishFullDir)\Runtime\**\*.*;$(_PublishFullDir)\Data\**\*.*;$(_PublishFullDir)\Scripts\**\*.*;$(_PublishFullDir)\Config\**\*.*;$(_PublishFullDir)\Logs\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_PublishRuntimeDir)" />
    <Move SourceFiles="@(_LoosePublishedFiles)"
          DestinationFiles="@(_LoosePublishedFiles->'$(_PublishRuntimeDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          OverwriteReadOnlyFiles="true"
          Condition="'$(_PublishLeafName)' != 'Runtime' and '@(_LoosePublishedFiles)' != ''" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_PublishAppRoot)\$(AssemblyName).exe"
                   DotNetSearchLocations="AppLocal;AppRelative;EnvironmentVariable;Global"
                   AppRelativeDotNet="..\.dotnet"
                   AppBinaryName="Runtime/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                   DisableCetCompat="$(_DisableCetCompat)" />
    <Delete Files="$(_PublishRuntimeDir)\$(AssemblyName).exe"
            Condition="Exists('$(_PublishRuntimeDir)\$(AssemblyName).exe')" />
  </Target>

  <!--
    JeekLauncherMcp is the Debug MCP stdio adapter (no product MCP surface exists yet, so
    Release builds skip it). Agents launch the fixed per-user copy under LocalAppData (via
    the repo-root JeekLauncherDebugMcp.cmd); this publishes the side-by-side copy inside
    Runtime\ that the app installs there on startup. Renaming the old file first lets Windows
    replace an image an agent still has running, instead of failing the build.
  -->
  <Target Name="PublishJeekLauncherMcp" AfterTargets="CreateNestedAppHostAfterBuild;CreateNestedAppHostAfterPublish"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true' and ('$(_IsPublishing)' != 'true' or '$(_PublishRuntimeDir)' != '')">
    <PropertyGroup>
      <_JeekLauncherMcpTargetDir>$(OutDir)</_JeekLauncherMcpTargetDir>
      <_JeekLauncherMcpTargetDir Condition="'$(_PublishRuntimeDir)' != ''">$(_PublishRuntimeDir)</_JeekLauncherMcpTargetDir>
      <JeekLauncherMcpDir>$([System.IO.Path]::GetFullPath('$(_JeekLauncherMcpTargetDir)', '$(MSBuildProjectDirectory)'))</JeekLauncherMcpDir>
      <_McpUnlockExe>$([System.IO.Path]::Combine('$(JeekLauncherMcpDir)', 'JeekLauncherMcp.exe'))</_McpUnlockExe>
      <_McpUnlockStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff'))</_McpUnlockStamp>
    </PropertyGroup>
    <Exec
      Condition="Exists('$(_McpUnlockExe)')"
      Command="move /Y &quot;$(_McpUnlockExe)&quot; &quot;$(_McpUnlockExe).$(_McpUnlockStamp).old&quot;"
      ContinueOnError="true" />
    <ItemGroup>
      <_McpUnlockOld Include="$(JeekLauncherMcpDir)\JeekLauncherMcp.exe.*.old" />
    </ItemGroup>
    <Delete Files="@(_McpUnlockOld)" TreatErrorsAsWarnings="true" ContinueOnError="true" />
    <MSBuild
      Projects="..\Tools\JeekLauncherMcp\JeekLauncherMcp.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(JeekLauncherMcpDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0.4" />
    <PackageReference Include="Jeek.Avalonia.Localization" Version="12.0.2" />
  </ItemGroup>

</Project>
