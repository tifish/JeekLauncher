<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JeekLauncher.ViewModels"
        xmlns:m="clr-namespace:JeekLauncher.Models"
        xmlns:l="using:Jeek.Avalonia.Localization"
        x:Class="JeekLauncher.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="Jeek Launcher"
        Width="640" Height="468"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LauncherCardBackground" Color="#F01D1E22" />
                    <SolidColorBrush x:Key="LauncherCardBorder" Color="#2EFFFFFF" />
                    <BoxShadows x:Key="LauncherCardShadow">0 10 34 0 #80000000</BoxShadows>
                    <SolidColorBrush x:Key="LauncherDividerBackground" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="LauncherStatusBarBackground" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="LauncherPrimaryForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="LauncherSecondaryForeground" Color="#A0FFFFFF" />
                    <SolidColorBrush x:Key="LauncherSubtitleForeground" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="LauncherBadgeBackground" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="LauncherBadgeForeground" Color="#90FFFFFF" />
                    <SolidColorBrush x:Key="LauncherButtonBackground" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="LauncherButtonForeground" Color="#E0FFFFFF" />
                    <SolidColorBrush x:Key="LauncherEditorBackground" Color="#22000000" />
                    <SolidColorBrush x:Key="LauncherPromptForeground" Color="#C0FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LauncherCardBackground" Color="#F5F6F7F9" />
                    <SolidColorBrush x:Key="LauncherCardBorder" Color="#26000000" />
                    <BoxShadows x:Key="LauncherCardShadow">0 10 30 0 #38000000</BoxShadows>
                    <SolidColorBrush x:Key="LauncherDividerBackground" Color="#18000000" />
                    <SolidColorBrush x:Key="LauncherStatusBarBackground" Color="#0C000000" />
                    <SolidColorBrush x:Key="LauncherPrimaryForeground" Color="#E6000000" />
                    <SolidColorBrush x:Key="LauncherSecondaryForeground" Color="#99000000" />
                    <SolidColorBrush x:Key="LauncherSubtitleForeground" Color="#78000000" />
                    <SolidColorBrush x:Key="LauncherBadgeBackground" Color="#12000000" />
                    <SolidColorBrush x:Key="LauncherBadgeForeground" Color="#88000000" />
                    <SolidColorBrush x:Key="LauncherButtonBackground" Color="#14000000" />
                    <SolidColorBrush x:Key="LauncherButtonForeground" Color="#D9000000" />
                    <SolidColorBrush x:Key="LauncherEditorBackground" Color="#0F000000" />
                    <SolidColorBrush x:Key="LauncherPromptForeground" Color="#B3000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="14"
            Background="{DynamicResource LauncherCardBackground}"
            BorderBrush="{DynamicResource LauncherCardBorder}"
            BorderThickness="1"
            BoxShadow="{DynamicResource LauncherCardShadow}">
        <DockPanel>

            <!-- Search box -->
            <Border DockPanel.Dock="Top" Padding="18,14,18,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding Query, Mode=TwoWay}"
                         PlaceholderText="{l:Localize SearchWatermark}"
                         FontSize="22"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center">
                    <TextBox.Styles>
                        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </TextBox.Styles>
                </TextBox>
            </Border>

            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LauncherDividerBackground}" />

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Padding="18,7" Background="{DynamicResource LauncherStatusBarBackground}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource LauncherSecondaryForeground}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="SetQuickWordButton"
                            Content="{l:Localize SetQuickWord}"
                            FontSize="11"
                            Padding="9,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LauncherButtonBackground}"
                            Foreground="{DynamicResource LauncherButtonForeground}"
                            BorderThickness="0"
                            CornerRadius="5" />
                </Grid>
            </Border>

            <!-- Quick-word editor (hidden until "Set quick word" is invoked) -->
            <Border x:Name="QuickWordEditor"
                    DockPanel.Dock="Bottom"
                    IsVisible="False"
                    Padding="18,10"
                    Background="{DynamicResource LauncherEditorBackground}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="QuickWordPrompt"
                               FontSize="11"
                               Foreground="{DynamicResource LauncherPromptForeground}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="QuickWordBox"
                             FontSize="15"
                             Padding="6,4"
                             PlaceholderText="{l:Localize QuickWordEditorWatermark}" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <ListBox x:Name="ResultList"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:AppEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="40">
                            <Image Grid.Column="0"
                                   Width="30" Height="30"
                                   Margin="2,0,14,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="{DynamicResource LauncherPrimaryForeground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource LauncherSubtitleForeground}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="8,0,2,0"
                                    Padding="7,2"
                                    CornerRadius="5"
                                    Background="{DynamicResource LauncherBadgeBackground}">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="11"
                                           Foreground="{DynamicResource LauncherBadgeForeground}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>
    </Border>
</Window>
