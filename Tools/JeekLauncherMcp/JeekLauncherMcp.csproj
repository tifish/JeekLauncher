<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekLauncherMcp</AssemblyName>
    <RootNamespace>JeekLauncherMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Publish as a single file into Runtime\ so the app root keeps only JeekLauncher.exe;
      startup installs that file at the stable per-user path under LocalAppData.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <OutDir>..\..\artifacts\JeekLauncherMcp</OutDir>
    <PublishDir>..\..\bin\Runtime</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names and routing, shared with the app. -->
    <Compile Include="..\..\JeekLauncher\Services\McpPipeNames.cs" Link="McpPipeNames.cs" />
    <Compile Include="..\..\JeekLauncher\Services\McpAdapterRegistry.cs" Link="McpAdapterRegistry.cs" />
  </ItemGroup>

</Project>
