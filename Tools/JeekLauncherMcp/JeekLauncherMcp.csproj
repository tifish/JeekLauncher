<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekLauncherMcp</AssemblyName>
    <RootNamespace>JeekLauncherMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Publish as one file beside the app; startup installs that file at the stable per-user
      path. Single-file matters with NetBeauty: it stamps a libloader hook into every
      *.runtimeconfig.json in the output folder, and an adapter carrying that hook would pin
      libloader.dll for the whole agent session, failing the app's next build. Bundling the
      runtimeconfig into the exe keeps NetBeauty from finding it.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <OutDir>..\..\artifacts\JeekLauncherMcp</OutDir>
    <PublishDir>..\..\bin</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names and routing, shared with the app. -->
    <Compile Include="..\..\JeekLauncher\Services\McpPipeNames.cs" Link="McpPipeNames.cs" />
    <Compile Include="..\..\JeekLauncher\Services\McpAdapterRegistry.cs" Link="McpAdapterRegistry.cs" />
  </ItemGroup>

</Project>
