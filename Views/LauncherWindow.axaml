<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JeekLauncher.ViewModels"
        xmlns:m="clr-namespace:JeekLauncher.Models"
        xmlns:l="using:Jeek.Avalonia.Localization"
        x:Class="JeekLauncher.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="Jeek Launcher"
        Width="640" Height="468"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Margin="14"
            CornerRadius="14"
            Background="#F01D1E22"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            BoxShadow="0 10 34 0 #80000000">
        <DockPanel>

            <!-- Search box -->
            <Border DockPanel.Dock="Top" Padding="18,14,18,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding Query, Mode=TwoWay}"
                         PlaceholderText="{l:Localize SearchWatermark}"
                         FontSize="22"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Top" Height="1" Background="#1AFFFFFF" />

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Padding="18,7" Background="#12FFFFFF">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="#A0FFFFFF"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Results -->
            <ListBox x:Name="ResultList"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:AppEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="40">
                            <Image Grid.Column="0"
                                   Width="30" Height="30"
                                   Margin="2,0,14,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="#FFFFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="#80FFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="8,0,2,0"
                                    Padding="7,2"
                                    CornerRadius="5"
                                    Background="#16FFFFFF">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="11"
                                           Foreground="#90FFFFFF" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>
    </Border>
</Window>
