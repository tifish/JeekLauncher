<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Jeek.Avalonia.Localization"
        x:Class="JeekLauncher.Views.SettingsWindow"
        Title="{l:Localize SettingsTitle}"
        Width="600" Height="580"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="{l:Localize Save}" Width="110" />
            <Button x:Name="CancelButton" Content="{l:Localize Cancel}" Width="110" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <Border x:Name="ErrorBanner"
                    IsVisible="False"
                    Background="#33E53935"
                    BorderBrush="#88E53935"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="0,0,0,4">
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFCDD2"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <TextBlock Text="{l:Localize GlobalHotkey}" FontWeight="Bold" />
            <TextBox x:Name="HotkeyBox" PlaceholderText="{l:Localize HotkeyWatermark}" />
            <TextBlock Text="{l:Localize HotkeyHint}" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" />

            <TextBlock Text="{l:Localize Language}" FontWeight="Bold" Margin="0,10,0,0" />
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" Width="240" />

            <CheckBox x:Name="StartupCheck" Content="{l:Localize StartWithWindows}" Margin="0,6,0,0" />

            <TextBlock Text="{l:Localize StorageMode}" FontWeight="Bold" Margin="0,10,0,0" />
            <ComboBox x:Name="StorageModeBox" HorizontalAlignment="Left" Width="240" />
            <TextBlock Text="{l:Localize StorageModeHint}" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" />
            <StackPanel x:Name="CustomDirPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
                <TextBox x:Name="CustomDirBox" Width="380" PlaceholderText="{l:Localize CustomDirWatermark}" />
                <Button x:Name="BrowseCustomDirButton" Content="{l:Localize Browse}" />
            </StackPanel>

            <TextBlock Text="{l:Localize ExtraFolders}" FontWeight="Bold" Margin="0,12,0,0" />
            <TextBlock Text="{l:Localize ExtraFoldersHint}" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" />
            <Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6" Height="170">
                <ListBox x:Name="DirsList" Background="Transparent" BorderThickness="0">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="OpenDirItem" Header="{l:Localize OpenFolder}" />
                            <MenuItem x:Name="RemoveDirItem" Header="{l:Localize Remove}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddDirButton" Content="{l:Localize AddFolder}" />
                <Button x:Name="RemoveDirButton" Content="{l:Localize RemoveSelected}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
